<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>mini whatshap</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>ALL CHATS</h3>
    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>
    <% for(chat of chats) {%>
        <div class="chat"> 
            <div> 
            <p> from : <%= chat.from %></p>
        </div>
        <div>
            <p> msg : <%= chat.msg %></p>
        </div>
        <p> to : <%= chat.to %></p>
        <p> time : <%= chat.created_at.toString().split(" ") [4]%></p> 
        <p> Date : <%= chat.created_at.toString().split(" ").splice(0, 4 ).join(" ")%></p>   
        <div class="buttons">
            <form method="GET" action="/chats/<%=chat.id%>/edit">
            <button>EDIT</button>
        </form>
         <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
            <button>DELETE</button>
        </form>
        </div>
    </div>
        <hr>
    <% } %>
</body>
</html>